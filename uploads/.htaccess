# =============================================================================
# uploads/ — product photos only.
# Nothing in here is ever executed: a .php file dropped into this folder is
# served as plain text, never run.
# =============================================================================

# Only -Indexes is set. -ExecCGI was removed on purpose: shared hosts such as
# InfinityFree often permit `AllowOverride Options=Indexes` but not ExecCGI, and
# an unsupported directive makes Apache return 500 for every request in this
# directory. That 500 was indistinguishable from a missing image.
Options -Indexes

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# Deny the dangerous extensions outright (belt and braces alongside engine off).
<FilesMatch "\.(php|php3|php4|php5|php7|php8|phtml|phar|cgi|pl|asp|aspx|jsp|sh|exe)$">
    Require all denied
</FilesMatch>

# Only images are expected here.
<FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|avif)$">
    Require all granted
</FilesMatch>
