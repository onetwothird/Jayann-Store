<?php

/**
 * Per-machine configuration overrides — TEMPLATE.
 *
 * This file is OPTIONAL. app/config.php picks the right database by itself:
 * localhost and *.local get the Laragon MySQL, every other hostname gets the
 * InfinityFree one. Neither deployment needs this file.
 *
 * Use it only for the cases the hostname cannot express — a preview deploy, a
 * second local database, or keeping a password out of git history:
 *
 *   1. copy this to config.local.php  (the copy is gitignored, the template is not)
 *   2. leave only the keys that differ
 *
 * The merge is array_replace_recursive, so a partial list is fine; anything
 * left out keeps the value from app/config.php.
 *
 * Prefer keeping the production password here over committing it, since this
 * file never reaches git while app/config.php does. Note that the RedirectMatch
 * rule for /app/ in the root .htaccess returns 404 for it over HTTP, so the
 * password is not readable from a browser either.
 */

declare(strict_types=1);

return [
    'db' => [
        // InfinityFree, if you would rather not put the password in config.php:
        // 'host'     => 'sql308.infinityfree.com',
        // 'name'     => 'if0_43025784_jayann_store',
        // 'user'     => 'if0_43025784',
        // 'password' => 'your-database-password',

        // A second local database:
        // 'host'     => 'localhost',
        // 'name'     => 'jayann_store_other',
        // 'user'     => 'root',
        // 'password' => '',
    ],
];
